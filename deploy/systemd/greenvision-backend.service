[Unit]
Description=GreenVision.AI backend (Flask + AI Engine)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/greenvision/server
ExecStart=/opt/greenvision/venv/bin/gunicorn --workers 1 --threads 1 --timeout 600 --bind 0.0.0.0:5000 app:app
Restart=always
RestartSec=5
Environment=PORT=5000
User=ubuntu

[Install]
WantedBy=multi-user.target